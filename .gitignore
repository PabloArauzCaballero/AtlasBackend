node_modules/
dist/
.env
*.log
.DS_Store
coverage/
tmp-*.log

# Portal de documentación construido por `yarn docs:build` (mkdocs `site_dir`). Es salida, no
# fuente: se regenera en cada build y en CI se publica como artefacto del job `contract-and-docs`.
site/

# Caché de bytecode del hook de MkDocs (`scripts/mkdocs/`). Lo genera el intérprete al
# construir el portal.
__pycache__/
*.pyc

# Grafo de conocimiento generado por graphify (artefacto local, se regenera con `graphify update .`).
# `.graphify/` es el layout actual (>=0.17); `graphify-out/` es el legado previo a la migración.
.graphify/
graphify-out/

# Evidencia de rendimiento e higiene de recursos (`scripts/perf/`). Son datos de una máquina y un
# instante concretos: se regeneran en cada corrida y en CI se publican como artefacto del job.
artifacts/

# Resultados locales generados por smoke tests (ATLAS-P0-SMOKE-001). Se siguen generando siempre;
# solo deben permanecer fuera del índice de Git. No usar una regla genérica como *.json aquí —
# excluiría JSON válidos del proyecto.
scripts/smoke/smoke-results.json
scripts/smoke/*.results.json
scripts/smoke/results/

# Archivos subidos por el adaptador de almacenamiento local (FILE_STORAGE_LOCAL_ROOT). Son datos de
# clientes generados en runtime: nunca deben entrar al repositorio.
var/

# Respaldos locales del .env: llevan credenciales reales y nunca deben versionarse.
.env.bak-*

# ATL-013 — Secretos: cualquier fichero .env queda fuera del repositorio, salvo las plantillas.
# Las reglas anteriores enumeraban variantes concretas (.env, .env.local, .env.bak-*), así que un
# nombre no previsto —`.env.bak`, el más probable al hacer una copia rápida— no coincidía con
# ninguna y quedaba listo para commitear. Se invierte: se ignora todo y se readmiten los ejemplos.
.env*
!.env*.example
