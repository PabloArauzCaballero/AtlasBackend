# Desarrollo local: mantener en development. Producción debe usar .env.production real.
NODE_ENV=development
APP_PORT=3005
API_PREFIX=api/v1
API_JSON_BODY_LIMIT=2mb
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5273
INTERNAL_FRONTEND_ORIGIN=http://localhost:5273

# PostgreSQL — RUNTIME del backend.
# DB_USER debe ser `atlas_app_rw`: CRUD sobre las tablas, sin DDL, sin TRUNCATE, sin ownership.
# NO uses `postgres` aquí: conectar el runtime como superusuario deja sin efecto todo el privilegio
# mínimo. Crea los roles con `yarn db:roles:bootstrap` (ver docs/database/postgres-roles.md).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlas
DB_USER=atlas_app_rw
DB_PASSWORD=
# `public` queda para metadata Umzug. Los modelos usan schemas de dominio explícitos (ver
# docs/database/domain-schemas.md); no cambies este valor para intentar seleccionar un dominio.
# ATLAS-SEC-012: vuelca cada sentencia SQL al log. Sequelize INLINEA los valores, así que en un
# backend KYC eso publica nombre, correo, teléfono y documento en claro. Apagado por defecto y
# prohibido en producción. Ver docs/adr/0008-logging-de-sql.md.
DB_LOG_SQL=false
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Pool de conexiones Sequelize (conexión de escritura). Sin estas vars Sequelize usa max=5, que se
# queda corto frente a la concurrencia real (el fan-out de notificaciones asume ~25). Dimensiona de
# forma que (instancias × DB_POOL_MAX) no supere el CONNECTION LIMIT de atlas_app_rw (50).
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# Techos del lado del SERVIDOR para cada sesion de Postgres del RUNTIME (no de migraciones).
# REQUEST_TIMEOUT_MS corta el request, pero no cancela la consulta: la conexion del pool sigue
# ocupada hasta que Postgres aborta su propio trabajo. `statement_timeout` es lo unico que se lo
# pide. `idle_in_transaction_session_timeout` mata transacciones abiertas que dejaron locks tomados
# porque el cliente murio a la mitad. 0 desactiva cada techo.
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Pool de la conexión de LECTURA (cuando DB_READ_ENABLED=true).
DB_READ_POOL_MAX=10

# Identidad que aplica MIGRACIONES y SEEDS (DDL). Separada del runtime a propósito: si compartieran
# usuario, `atlas_app_rw` necesitaría DDL y el privilegio mínimo sería ficticio.
# Si se deja vacío, cae a DB_USER (cómodo en local antes de separar roles).
DB_MIGRATION_USER=atlas_migrator
DB_MIGRATION_PASSWORD=

# Identidad ADMINISTRATIVA: solo la usa `yarn db:roles:bootstrap` para crear los roles del cluster
# (requiere CREATE ROLE). El runtime nunca la usa. Si se deja vacío, cae a DB_USER.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Contraseñas que `yarn db:roles:bootstrap` asigna a cada rol. Sin default a propósito: una
# contraseña de repuesto en código es indistinguible de una credencial filtrada.
DB_APP_RW_PASSWORD=
DB_APP_RO_PASSWORD=
DB_MIGRATOR_PASSWORD=

# Conexión de ESCRITURA / default: apunta DB_USER a atlas_app_rw en entornos con roles diferenciados
# (ver docs/database/postgres-roles.md). Las migraciones deben correr con atlas_migrator, no con este
# usuario runtime.
#
# Pool de LECTURA opcional (Fase 5): cuando DB_READ_ENABLED=true, se registra una segunda conexión
# "read" con estas variables (apúntalas a atlas_app_ro y, en el futuro, a una réplica). Cualquier
# campo vacío cae al valor de escritura equivalente.
DB_READ_ENABLED=false
DB_READ_HOST=
DB_READ_PORT=
DB_READ_NAME=
DB_READ_USER=
DB_READ_PASSWORD=
DB_READ_SCHEMA=
DB_READ_SSL=

# Perfil de seeds a ejecutar: production | development | demo | test.
# Si se deja vacío, el runner lo deriva de NODE_ENV (production->production, test->test, resto->development).
# Se puede sobrescribir por comando con `--profile=...` (ver `yarn db:seed:prod|dev|demo|test`).
# production solo carga catálogos/baselines de arranque; jamás clientes, usuarios ni operaciones ficticias.
SEED_PROFILE=

# Seeds / reset de datos de prueba.
# DATABASE_CLEAN_BEFORE_SEED=true borra los datos de aplicación antes de `yarn db:seed:up`.
# Preserva SequelizeMeta, limpia las tablas de tracking de seeders y recarga los datos semilla del perfil.
DATABASE_CLEAN_BEFORE_SEED=false
DATABASE_CLEAN_ALLOW_PRODUCTION=false
DATABASE_CLEAN_CONFIRM=

# Seeding idempotente AL ARRANCAR (opt-in). Si es true, el backend aplica al iniciar los seeders
# PENDIENTES del perfil (derivado de SEED_PROFILE/NODE_ENV) de forma idempotente — Umzug solo corre
# los no ejecutados. En local (development) siembra el admin pablo@atlas.internal sin comandos extra.
# NUNCA corre seeders de dev/demo en producción (el perfil production solo incluye el stage production).
# Usa la identidad de migración (DB_MIGRATION_USER, cae a DB_USER en local).
DATABASE_SEED_ON_STARTUP=false
# Si el seeding al arrancar falla y esto es true, el arranque ABORTA. Por defecto se loguea y sigue.
DATABASE_SEED_ON_STARTUP_FAIL_FAST=false

# Identidad del SUPER_ADMIN del perfil `development`. Vacías = el default de siempre
# (pablo@atlas.internal + el hash versionado en el seeder), que es lo que espera CI.
# Rellénalas con TU correo real y TU contraseña si quieres recibir de verdad el PIN del segundo
# factor y el correo de reset: `@atlas.internal` no es un dominio que exista, así que con el default
# esos flujos no se pueden probar contra un buzón. La contraseña se hashea al sembrar y nunca sale de
# este archivo (que está en .gitignore) — ver ATLAS-P0-002 en docs/database/dev-credentials.md.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Contraseña de los partners que siembra el perfil `development`
# (`development/20260821140000-seed-partners-desarrollo`). Vacía = el default versionado en el
# propio seeder, que por estar en el repositorio se considera conocido; se rellena en una máquina
# donde eso importe. Sólo se lee fuera de producción.
DEV_PARTNER_PASSWORD=

# Auth
# Usuario seed para desarrollo del panel interno: pablo@atlas.internal (contraseña: ver
# docs/database/dev-credentials.md — no se versiona en texto plano, pedirla al dueño de la cuenta).
JWT_ACCESS_TOKEN_SECRET=change-this-secret-with-at-least-32-characters

# Solo necesarias para correr manualmente `yarn smoke:internal-rbac` / `yarn smoke:frontend-contract`
# (no forman parte de la suite de smoke que corre en CI). Sin valor por defecto a propósito
# (ATLAS-P0-SEC-001): un smoke que autentica de verdad no debe traer una contraseña embebida.
# INTERNAL_SMOKE_PASSWORD=
# INTERNAL_SMOKE_QA_PASSWORD=
SYSTEM_TEST_ALLOWED_HOSTS_LOCAL=localhost,127.0.0.1,::1,host.docker.internal
SYSTEM_TEST_ALLOWED_HOSTS_STAGING=staging-api.example.com
SYSTEM_TEST_ALLOWED_HOSTS_PRODUCTION_READONLY=
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
# Emisor y audiencia del token de acceso: acotan para QUE vale un token firmado con el secreto.
# Cambiarlos invalida los tokens de acceso vigentes (los refresh tokens no se ven afectados).
JWT_ISSUER=atlas-backend
JWT_AUDIENCE=atlas-api

# ATLAS-AUDIT-002: configuración del módulo auth (login/refresh/logout).
AUTH_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_PIN_ENABLED=true
AUTH_ONE_TIME_CODE_TTL_MINUTES=10
AUTH_ONE_TIME_CODE_MAX_ATTEMPTS=5

# Cookies HttpOnly del panel interno. Usa `none` solo entre dominios distintos y siempre con Secure.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# ATLAS-AUDIT-023: Redis para rate limiting distribuido. Obligatorio en producción (ver
# src/config/env.ts). En local/desarrollo con una sola instancia puede dejarse vacío: el
# throttler cae a almacenamiento en memoria (correcto solo con una única instancia).
# Ejemplo local: redis://localhost:6379
REDIS_URL=

# API rate limit. Raise API_RATE_LIMIT_MAX only in controlled stress environments.
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=100

# MailSender — entrega de PIN, recuperación y verificación por correo. Vacío = integración apagada.
MAILSENDER_BASE_URL=
MAILSENDER_API_PREFIX=/api/v1
MAILSENDER_EXTERNAL_API_KEY=
MAILSENDER_ADMIN_USERNAME=
MAILSENDER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# ATLAS Decision Engine — la política versionada que decide crédito
# -----------------------------------------------------------------------------
# Vacío = integración APAGADA. Con la integración apagada la decisión de crédito NO se
# automatiza: cada solicitud cae a revisión humana. Ese es el respaldo correcto — aprobar
# crédito con reglas fijas en código es justo lo que `risk_heuristic_v0` dice de sí mismo
# que no debe hacerse.
#
# DOS credenciales, no una. El motor separa dos planos y mezclarlos le daría al componente
# que decide la capacidad de reescribir la medida de su propio acierto:
#   DECISION_ENGINE_API_KEY          → audiencia `runtime`, rol DECISION_RUNTIME. Ejecuta decisiones.
#   DECISION_ENGINE_OUTCOME_API_KEY  → plano de gestión, rol OPERATIONS. Carga desenlaces observados.
DECISION_ENGINE_BASE_URL=
DECISION_ENGINE_API_KEY=
DECISION_ENGINE_OUTCOME_API_KEY=
#   DECISION_ENGINE_GOVERNANCE_API_KEY → plano de gestión, rol COMPLIANCE/OPERATIONS. Replica el
#                                        permiso del titular para que el motor pueda ejercerlo.
#                                        Si falta, se usa la de desenlaces.
DECISION_ENGINE_GOVERNANCE_API_KEY=
#   DECISION_ENGINE_AUDIO_API_KEY      → plano de gestión, rol OPERATIONS. Encarga la locución de
#                                        bienvenida al worker de audio. Aparte de las demás porque
#                                        lo que autoriza CUESTA DINERO: cada locución nueva es una
#                                        llamada facturada a ElevenLabs, y hay que poder revocarla
#                                        sola. Si falta, se usa la de gobierno; nunca la de ejecución.
DECISION_ENGINE_AUDIO_API_KEY=
# Cuánto se espera al worker de locución. Aparte —y más largo— que el de las decisiones: encolar una
# locución tarda entre 1 y 14 s (caché por contenido, presupuesto y cuota) frente a menos de 1 s de
# una decisión de crédito. Con los 10 s del otro, la mitad de los saludos morían por timeout.
DECISION_ENGINE_AUDIO_TIMEOUT_MS=25000
# Plantilla del catálogo de locución con la que se saluda a quien acaba de entrar, y a cuál caer
# cuando no se sabe su nombre. Son CÓDIGOS de plantilla, no textos: el motor no locuta texto libre,
# y ahí está lo que impide que la voz de la marca diga cualquier cosa.
DECISION_ENGINE_WELCOME_TEMPLATE=onboarding.welcome.named
DECISION_ENGINE_WELCOME_FALLBACK_TEMPLATE=onboarding.welcome.generic
# Código del artefacto desplegado que resuelve una solicitud de crédito.
DECISION_ENGINE_CREDIT_ARTIFACT=credit_underwriting
# Artefacto que evalúa el riesgo de onboarding — el trabajo que hoy hace `risk_heuristic_v0`.
# Vacío = el motor no participa en riesgo y manda la política local. Se apaga por separado del de
# crédito porque son dos decisiones distintas: se puede automatizar una y todavía no la otra.
DECISION_ENGINE_RISK_ARTIFACT=
# Artefacto que verifica identidad con carnet y selfie para el front móvil.
DECISION_ENGINE_IDENTITY_ARTIFACT=IDENTIDAD_CARNET_MOVIL
# Ambiente del motor contra el que se ejecuta. Vacío = el que el despliegue tenga activo.
DECISION_ENGINE_ENVIRONMENT_CODE=
# Ruta del healthcheck del motor. Parametrizada porque el prefijo de rutas es del otro repo:
# un cambio suyo no debe leerse aquí como «motor caído».
# Dirección del motor SÓLO para reportar su salud en el panel de sistemas. Aparte de BASE_URL
# porque preguntar «¿estás en pie?» no debe exigir las credenciales que sí exige decidir crédito.
# Si BASE_URL está configurada, manda ella.
DECISION_ENGINE_HEALTH_BASE_URL=
DECISION_ENGINE_HEALTH_PATH=/health
DECISION_ENGINE_TIMEOUT_MS=10000
DECISION_ENGINE_RETRIES=1
DECISION_ENGINE_RETRY_BASE_DELAY_MS=250

# Catalogo federado del motor: el manifiesto con el que el portal interno deja de ensenar solo las
# tablas y rutas de este backend, mas las rutas de artefactos y despliegues para la vista de
# artefactos ACTIVOS.
#
# NO hay credencial que configurar. El motor trata a ESTE backend como su proveedor de identidad
# (verifica cada token contra /internal/auth/me), asi que estas lecturas viajan con el token de la
# persona que las pidio: quedan auditadas a su nombre y sujetas a SUS roles. Una llave de servicio
# aqui la sustituiria por «Atlas» y saltaria el control de roles del motor.
DECISION_ENGINE_CATALOG_PATH=/v1/platform/catalog-manifest
# Plazo propio: una introspeccion completa no cabe en el tiempo de un healthcheck.
DECISION_ENGINE_CATALOG_TIMEOUT_MS=30000
DECISION_ENGINE_ARTIFACTS_PATH=/v1/artifacts
DECISION_ENGINE_DEPLOYMENTS_PATH=/v1/deployments
# Sal del identificador opaco del sujeto. CAMBIARLA PARTE LA HISTORIA: el mismo cliente
# pasaría a verse como uno nuevo y sus decisiones anteriores quedarían huérfanas. Rotarla
# es una migración, no un ajuste. En producción, un secreto real y largo.
DECISION_ENGINE_SUBJECT_SALT=change-this-long-unique-salt-for-subject-references

# --- ATLAS ERP Backend (sólo observabilidad) --------------------------------
# Este backend NO consume la API del ERP: son dos productos con bases separadas. Sólo necesita
# saber dónde vive para responder por su salud en el panel de sistemas del portal interno. Vacío =
# la herramienta ERP_BACKEND se reporta como NO CONFIGURADA, que es honesto; nunca como sana.
ERP_BACKEND_BASE_URL=
ERP_BACKEND_HEALTH_PATH=/api/v1/health
ERP_BACKEND_TIMEOUT_MS=5000

# Catalogo federado del ERP. Credencial de UN SOLO proposito: el ERP no comparte su JWT interno con
# este backend —quien lo tiene puede firmarse cualquier rol— y publica en su lugar una llave que
# solo abre la lectura del manifiesto. Debe coincidir con PLATFORM_CATALOG_API_KEY del ERP.
ERP_BACKEND_CATALOG_PATH=/api/v1/platform/catalog-manifest
ERP_BACKEND_CATALOG_API_KEY=
ERP_BACKEND_CATALOG_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Notifications core
# -----------------------------------------------------------------------------
# in_app does not require an external provider. It is delivered inside ATLAS.
# External channels are disabled by default to avoid accidental sends.
# Enable each channel by changing provider and setting the provider credentials.
NOTIFICATION_DEFAULT_LOCALE=es-BO
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_SMS_PROVIDER=disabled
NOTIFICATION_WHATSAPP_PROVIDER=disabled
NOTIFICATION_PHONE_PROVIDER=disabled

# Secret used to encrypt FCM tokens and delivery targets.
# Local: este valor de ejemplo es aceptado solo con NODE_ENV=development/test.
# Producción: usar un secreto real, largo, único y distinto de JWT_ACCESS_TOKEN_SECRET.
NOTIFICATION_TOKEN_ENCRYPTION_KEY=change-this-32-plus-character-key-for-device-tokens

# Provider HTTP behavior for JSON-based adapters/webhooks.
NOTIFICATION_PROVIDER_HTTP_TIMEOUT_MS=15000
NOTIFICATION_PROVIDER_HTTP_RETRIES=1
NOTIFICATION_PROVIDER_HTTP_RETRY_BASE_DELAY_MS=250
# For fintech privacy, default data-only push. Set true only if you intentionally want visible OS notifications.
NOTIFICATION_PUSH_INCLUDE_VISIBLE_NOTIFICATION=false

# Generic webhook fallback used when a channel-specific webhook URL is not set.
# Channel-specific URLs are recommended when testing several channels at once.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_PHONE_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Email providers
# NOTIFICATION_EMAIL_PROVIDER=disabled | resend | sendgrid | gmail_api | webhook
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Push providers
# NOTIFICATION_PUSH_PROVIDER=disabled | fcm | webhook
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Use \n escaped line breaks when storing this in .env.
FCM_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# SMS provider
# NOTIFICATION_SMS_PROVIDER=disabled | twilio | webhook
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# -----------------------------------------------------------------------------
# WhatsApp providers
# NOTIFICATION_WHATSAPP_PROVIDER=disabled | meta_cloud | twilio | webhook
# -----------------------------------------------------------------------------
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Optional fallback template for Meta WhatsApp Cloud API. Prefer explicit template mapping by event/template_code.
META_WHATSAPP_DEFAULT_TEMPLATE_NAME=
META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=es

# Envelope encryption con AWS KMS. Si ambas están definidas, el runtime activa KmsKeyProvider.
# En producción configura credenciales AWS por IAM role/workload identity, no en este archivo.
# ATLAS-SEC-011: en producción SIN KMS la master key de toda la PII se deriva de una env var.
# Arrancar así exige declararlo aquí: el riesgo queda firmado en el manifiesto, no asumido.
PII_ENCRYPTION_ALLOW_ENV_MASTER_KEY=false
KMS_KEY_ID=
AWS_REGION=

# Evidencia documental compatible con S3 (AWS, MinIO, R2, B2). Vacío = endpoints de carga en 503.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Servicio de archivos por adaptadores (src/common/files)
# Dos ejes independientes. No sustituye a STORAGE_S3_*: la evidencia KYC conserva
# su propio camino prefirmado.
#   FILE_INGEST_ADAPTER  = multer   (multipart a través de la API)
#   FILE_STORAGE_ADAPTER = local    (disco; Cloudinary/S3 se suman como adaptadores)
# -----------------------------------------------------------------------------
FILE_INGEST_ADAPTER=multer
FILE_STORAGE_ADAPTER=local
FILE_UPLOAD_MAX_BYTES=15728640
FILE_UPLOAD_MAX_FILES=5
# Solo tipos con firma mágica conocida: image/jpeg, image/png, application/pdf, image/gif, image/webp.
# Declarar cualquier otro impide arrancar, en vez de aceptarlo sin verificar.
FILE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
FILE_UPLOAD_URL_TTL_SECONDS=300
FILE_STORAGE_LOCAL_ROOT=var/files
FILE_STORAGE_LOCAL_BASE_URL=http://localhost:3005/api/v1/files
# Firma HMAC de los tickets de subida locales (equivalente al prefirmado SigV4 de S3).
# Vacío en desarrollo = no se emiten tickets; la subida multipart directa sigue disponible.
FILE_STORAGE_LOCAL_URL_SECRET=

# -----------------------------------------------------------------------------
# Phone/call provider
# NOTIFICATION_PHONE_PROVIDER=disabled | webhook
# Real phone-call vendors should be connected behind the webhook adapter first,
# unless a first-class provider adapter is implemented later.
# -----------------------------------------------------------------------------

# External Data Providers
# En produccion, un proveedor en modo mock_local/mock_server queda BLOQUEADO (PROVIDER_UNAVAILABLE)
# salvo que se active este escape hatch a proposito. Fuera de produccion el flag es irrelevante.
EXTERNAL_PROVIDERS_ALLOW_MOCK_IN_PRODUCTION=false
EXTERNAL_PROVIDERS_MOCK_BASE_URL=http://localhost:4010/mock

# Escaneo antimalware de la evidencia subida (clamd por TCP).
# MALWARE_SCAN_HOST vacío = apagado. Aceptable solo en desarrollo: sin escaneo, un documento
# infectado queda persistido y se sirve a quien revise el caso.
MALWARE_SCAN_HOST=
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=20000
# fail-closed: si el escáner no responde, la subida se RECHAZA en vez de aceptarse sin revisar.
MALWARE_SCAN_FAIL_CLOSED=true
SEGIP_MODE=mock_local
SEGIP_MOCK_BASE_URL=http://localhost:4010/mock/segip
SEGIP_BASE_URL=
SEGIP_CLIENT_ID=
SEGIP_CLIENT_SECRET=
INFOCENTER_MODE=mock_local
INFOCENTER_MOCK_BASE_URL=http://localhost:4010/mock/infocenter
INFOCENTER_BASE_URL=
INFOCENTER_CLIENT_ID=
INFOCENTER_CLIENT_SECRET=
INFOCENTER_ALLOW_AUTOMATIC_QUERIES=false
INFOCENTER_DEFAULT_BLOCK_BY_COST=true
QR_GENERIC_MODE=mock_local
QR_GENERIC_MOCK_BASE_URL=http://localhost:4010/mock/qr
BANKING_GENERIC_MODE=mock_local
BANKING_GENERIC_MOCK_BASE_URL=http://localhost:4010/mock/banking
TELCO_GENERIC_MODE=mock_local
TELCO_GENERIC_MOCK_BASE_URL=http://localhost:4010/mock/telco
FACEBOOK_META_MODE=mock_local
FACEBOOK_META_MOCK_BASE_URL=http://localhost:4010/mock/facebook
WHATSAPP_GENERIC_MODE=mock_local
WHATSAPP_GENERIC_MOCK_BASE_URL=http://localhost:4010/mock/whatsapp
DIGITAL_TRUST_GENERIC_MODE=mock_local
DIGITAL_TRUST_GENERIC_MOCK_BASE_URL=http://localhost:4010/mock/digital-trust
MOCK_PROVIDERS_PORT=4010
MOCK_PROVIDERS_DEFAULT_LATENCY_MS=300
MOCK_PROVIDERS_SCENARIO=happy_path

# External providers v4 resilience / long-term controls
EXTERNAL_PROVIDER_CACHE_TTL_SECONDS=0
EXTERNAL_FEATURE_MAX_AGE_HOURS=168
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_WINDOW_MS=600000

# External providers v5 governance
EXTERNAL_PROVIDER_PROD_GATE_SANITIZATION_SAMPLE=100
EXTERNAL_PROVIDER_SLA_FAILURE_WARN_PERCENT=10
EXTERNAL_PROVIDER_SLA_P95_LATENCY_WARN_MS=5000


# -----------------------------------------------------------------------------
# Remote append-only sync de Archivo.log hacia MongoDB
# -----------------------------------------------------------------------------
# Configura MONGO_DB_URL_CONNECTION solo en .env local real o secret manager.
# Si queda vacio, el modulo no intenta conectar a Mongo.
MONGO_DB_URL_CONNECTION=
MONGO_LOGS_DB_NAME=atlas_logs
MONGO_LOGS_COLLECTION=archivo_log_updates
# Techo del archivo de log antes de rotar a <archivo>.1 (ATLAS-OPS-012). Sin Mongo configurado
# nada truncaba el archivo y crecía hasta llenar el disco del contenedor.
LOG_FILE_MAX_BYTES=67108864
LOG_SYNC_FILE_PATH=Archivo.log
LOG_SYNC_INTERVAL_MS=5000
LOG_SYNC_MAX_CHUNK_BYTES=1000000
LOG_SYNC_IMPORT_EXISTING_ON_FIRST_BOOT=false
LOG_SYNC_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
LOG_SYNC_FAILURES_BEFORE_PAUSE=3
LOG_SYNC_FAILURE_PAUSE_MS=60000

# Monitor periódico de herramientas críticas y notificación a operadores internos.
SYSTEM_HEALTH_MONITOR_ENABLED=true
SYSTEM_HEALTH_MONITOR_INTERVAL_MS=60000


# -----------------------------------------------------------------------------
# OpenTelemetry (trazas) — OPT-IN. Si OTEL_ENABLED != true, el tracing es no-op.
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
# Endpoint OTLP/HTTP del collector (p.ej. http://localhost:4318/v1/traces).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampling: en producción NO muestrees al 100% (el default del SDK). Usa un ratio parent-based.
# El NodeSDK respeta estas vars estándar de OTel de serie.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# -----------------------------------------------------------------------------
# Rol del proceso (API / worker)
# -----------------------------------------------------------------------------
# all    = un solo proceso atiende HTTP y ejecuta el trabajo de fondo (default y modo de desarrollo).
# api    = solo HTTP; no arranca ningun trabajo de fondo.
# worker = solo trabajo de fondo; no monta la API de negocio, solo sonda y /metrics.
# Ver docs/architecture/background-processing.md.
APP_ROLE=all
# Puerto de la sonda del worker (/health/liveness, /health/readiness, /metrics).
WORKER_PROBE_PORT=3006

# -----------------------------------------------------------------------------
# Trabajos de fondo programados (RuntimeJobsSchedulerService)
# -----------------------------------------------------------------------------
# Opt-in: sin esto los jobs solo corren si alguien llama a POST /operations/jobs/*.
# En produccion hace falta REDIS_URL para la eleccion de lider entre instancias.
RUNTIME_JOBS_SCHEDULER_ENABLED=false
RUNTIME_JOBS_ALLOW_WITHOUT_LOCK=false
RUNTIME_JOBS_BATCH_LIMIT=100
RUNTIME_JOBS_LEADER_LOCK_TTL_MS=900000
RUNTIME_JOBS_OUTBOX_INTERVAL_MS=30000
RUNTIME_JOBS_EVENTS_INTERVAL_MS=30000
RUNTIME_JOBS_SESSIONS_INTERVAL_MS=300000
RUNTIME_JOBS_SESSION_MAX_IDLE_MINUTES=120
RUNTIME_JOBS_RETENTION_INTERVAL_MS=86400000
RUNTIME_JOBS_DATA_QUALITY_INTERVAL_MS=3600000
# Rescate de eventos VARADOS en `processing`: los que un proceso reclamo y no llego a resolver
# porque murio a mitad de la tanda. Sin este barrido quedan bloqueados para siempre (toda consulta
# de reclamo filtra por status='pending'). El corte debe superar la duracion normal de una entrega.
RUNTIME_JOBS_STUCK_EVENTS_INTERVAL_MS=300000
RUNTIME_JOBS_STUCK_EVENT_MINUTES=15
# Techo de duracion de UNA tanda. Al vencer se reporta `outcome="stalled"` (metrica + log): el job
# no vuelve a correr hasta que termine, y esa es la senal que convierte un job muerto en algo
# alertable en vez de silencio. 0 lo desactiva.
RUNTIME_JOBS_TICK_TIMEOUT_MS=300000
# Desfase aleatorio del PRIMER disparo de cada job. Evita que N replicas que arrancan juntas pidan
# el mismo lock y consulten la lista de tenants en el mismo milisegundo. 0 lo desactiva.
RUNTIME_JOBS_START_JITTER_MS=15000
RUNTIME_JOBS_NOTIFICATION_RETRY_INTERVAL_MS=300000
RUNTIME_JOBS_NOTIFICATION_STUCK_MINUTES=15
# Cierre de los onboardings abandonados: sin este barrido `completion_status` se quedaba en
# `in_progress` para siempre y no existía tasa de abandono del registro. Diario, porque el
# umbral se mide en días de inactividad.
RUNTIME_JOBS_ONBOARDING_ABANDONMENT_INTERVAL_MS=86400000
RUNTIME_JOBS_ONBOARDING_ABANDONMENT_DAYS=30
RUNTIME_JOBS_IDEMPOTENCY_PURGE_INTERVAL_MS=86400000
RUNTIME_JOBS_IDEMPOTENCY_RETENTION_DAYS=30
# Retención de eventos de outbox ya procesados (ATLAS-DATA-003). Sin purga, la tabla crecía sin
# techo en la ruta más caliente de escritura y degradaba el índice de reclamo de pendientes.
RUNTIME_JOBS_OUTBOX_RETENTION_DAYS=30
RUNTIME_JOBS_NOTIFICATION_DELIVERY_INTERVAL_MS=10000
# inline   = la entrega del broadcast corre en el proceso que atendio el POST (default).
# deferred = el request solo persiste los mensajes; los entrega el worker. Requiere un worker vivo.
NOTIFICATIONS_DELIVERY_MODE=inline

# -----------------------------------------------------------------------------
# Identidad del build y ciclo de vida del proceso
# -----------------------------------------------------------------------------
# Las inyecta el pipeline al construir la imagen; /health las reporta. Vacias en local.
APP_VERSION=
APP_COMMIT_SHA=
APP_BUILT_AT=
# json = una linea JSON por evento en stdout, con correlationId/traceId y PII redactada.
# pretty = formato humano de ConsoleLogger. Sin valor: json en produccion, pretty en el resto.
LOG_FORMAT=pretty
# Al recibir SIGTERM, readiness pasa a 503 y se espera esto antes de cerrar. 0 = sin drenado.
SHUTDOWN_DRAIN_MS=0
# Techo de duracion de cualquier peticion HTTP. 0 = desactivado.
REQUEST_TIMEOUT_MS=30000
# Techo del ping de Postgres del readiness probe. Con el pool agotado, `authenticate()` espera hasta
# DB_POOL_ACQUIRE_MS por una conexion y el probe deja de responder justo cuando su respuesta es la
# informacion mas valiosa: pasa de detectar la saturacion a alimentarla.
HEALTH_DB_PING_TIMEOUT_MS=2000

# --- Credenciales de proveedor externo exigidas por PRODUCTION_CREDENTIAL_REQUIREMENTS ----------
# Ninguna tiene consumidor todavia: NINGUN adaptador tiene integracion real, asi que estas claves
# solo abren el porton de `${CODE}_MODE=production`. Ver docs/config/credenciales-requeridas.md.
QR_GENERIC_BASE_URL=
BANKING_GENERIC_BASE_URL=
TELCO_GENERIC_BASE_URL=
DIGITAL_TRUST_GENERIC_BASE_URL=
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_REDIRECT_URI=
# OJO: distinta de NOTIFICATION_WHATSAPP_PROVIDER (que gobierna el ENVIO de notificaciones).
# Esta identifica al proveedor del canal WhatsApp como fuente de datos de contactabilidad.
WHATSAPP_PROVIDER=
