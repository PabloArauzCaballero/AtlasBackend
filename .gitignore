node_modules/
dist/
.env
*.log
.DS_Store
coverage/
tmp-*.log

# Portal de documentación construido por `yarn docs:build` (mkdocs `site_dir`). Es salida, no
# fuente: se regenera en cada build y en CI se publica como artefacto del job `contract-and-docs`.
site/

# Caché de bytecode del hook de MkDocs (`scripts/mkdocs/`). Lo genera el intérprete al
# construir el portal.
__pycache__/
*.pyc

# Grafo de conocimiento generado por graphify (artefacto local, se regenera con `graphify update .`).
graphify-out/

# Resultados locales generados por smoke tests (ATLAS-P0-SMOKE-001). Se siguen generando siempre;
# solo deben permanecer fuera del índice de Git. No usar una regla genérica como *.json aquí —
# excluiría JSON válidos del proyecto.
scripts/smoke/smoke-results.json
scripts/smoke/*.results.json
scripts/smoke/results/
