{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.atlas.internal/atlas-integration-v1/payment.reported.v1.schema.json",
  "title": "payment.reported v1 — el cliente avisó en Core que pagó una cuota al comercio",
  "description": "No salda la cuota. Productor: Core (loan-payment-claims). Consumidor: ERP (crea el aviso REPORTED de la cuota mapeada).",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimId", "claimCode", "loanId", "installmentId", "customerId", "partnerProfileId", "amount", "currencyCode", "aggregateVersion"],
  "properties": {
    "claimId": { "$ref": "common.schema.json#/$defs/coreId" },
    "claimCode": { "type": "string", "minLength": 1, "maxLength": 80 },
    "loanId": { "$ref": "common.schema.json#/$defs/coreId" },
    "installmentId": { "$ref": "common.schema.json#/$defs/coreId" },
    "customerId": { "$ref": "common.schema.json#/$defs/coreId" },
    "partnerProfileId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/coreId" }, { "type": "null" }] },
    "amount": { "$ref": "common.schema.json#/$defs/positiveDecimalAmount" },
    "currencyCode": { "$ref": "common.schema.json#/$defs/currency" },
    "aggregateVersion": { "type": "integer", "minimum": 1 }
  }
}
