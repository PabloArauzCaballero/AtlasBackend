# Copiar a .env.production real en infraestructura/secret manager, nunca commitear secretos reales.
NODE_ENV=production
APP_PORT=3000

# Rol del proceso. Con `all` una sola pieza hace ambas cosas. Para separarlos, despliega dos
# conjuntos con la MISMA imagen: APP_ROLE=api (comando `node dist/src/main.js`) y APP_ROLE=worker
# (comando `node dist/src/worker.js`). El worker exige RUNTIME_JOBS_SCHEDULER_ENABLED=true, y las
# replicas de API exigen RUNTIME_JOBS_SCHEDULER_ENABLED=false. Ver docs/architecture/background-processing.md.
APP_ROLE=all
WORKER_PROBE_PORT=3006
API_PREFIX=api/v1
API_JSON_BODY_LIMIT=2mb
CORS_ORIGINS=https://admin.tudominio.com,https://merchant.tudominio.com
INTERNAL_FRONTEND_ORIGIN=https://admin.tudominio.com

DB_HOST=<postgres-host>
DB_PORT=5432
DB_NAME=atlas
DB_USER=<postgres-user>
DB_PASSWORD=<postgres-password>
DB_SCHEMA=public
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
# Techos de sesion de Postgres (runtime, no migraciones). Deben ser MAYORES que REQUEST_TIMEOUT_MS:
# la peticion debe rendirse antes de que la base mate la consulta, para que el 503 sea del servicio.
DB_STATEMENT_TIMEOUT_MS=60000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DB_READ_POOL_MAX=10

# Identidad DDL separada del runtime atlas_app_rw.
DB_MIGRATION_USER=atlas_migrator
DB_MIGRATION_PASSWORD=<secreto-migrator>
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_APP_RW_PASSWORD=<secreto-app-rw>
DB_APP_RO_PASSWORD=<secreto-app-ro>
DB_MIGRATOR_PASSWORD=<secreto-migrator>

# Seeds / reset de datos de prueba.
# DATABASE_CLEAN_BEFORE_SEED=true borra los datos de aplicación antes de `yarn db:seed:up`.
# Preserva SequelizeMeta, limpia SequelizeDataSeeders y recarga todos los datos semilla.
DATABASE_CLEAN_BEFORE_SEED=false
DATABASE_CLEAN_ALLOW_PRODUCTION=false
DATABASE_CLEAN_CONFIRM=

# Producción: no usar valores de ejemplo y no reutilizar el mismo secreto entre variables.
JWT_ACCESS_TOKEN_SECRET=<minimo-32-caracteres-aleatorio-unico>
SYSTEM_TEST_ALLOWED_HOSTS_LOCAL=
SYSTEM_TEST_ALLOWED_HOSTS_STAGING=<api-staging-controlada>
SYSTEM_TEST_ALLOWED_HOSTS_PRODUCTION_READONLY=<api-produccion-controlada>
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
# Emisor y audiencia del token de acceso. Un token firmado con el mismo secreto para otro proposito
# (p. ej. una sonda interna) no es aceptable como sesion si no declara estos dos claims.
JWT_ISSUER=atlas-backend
JWT_AUDIENCE=atlas-api
NOTIFICATION_TOKEN_ENCRYPTION_KEY=<otro-secreto-minimo-32-caracteres-aleatorio-unico>

# Obligatorio en producción para rate limiting distribuido multiinstancia.
REDIS_URL=redis://<usuario>:<password>@<host>:6379
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=100

# Swagger apagado por defecto en producción. Activar solo detrás de VPN/IP allowlist.
API_DOCS_ENABLED=false

AUTH_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_PIN_ENABLED=true
AUTH_ONE_TIME_CODE_TTL_MINUTES=10
AUTH_ONE_TIME_CODE_MAX_ATTEMPTS=5
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=.tudominio.com
AUTH_COOKIE_SECURE=true

# MailSender transaccional para PIN/reset/verificación por correo.
MAILSENDER_BASE_URL=https://mail.tudominio.com
MAILSENDER_API_PREFIX=/api/v1
MAILSENDER_EXTERNAL_API_KEY=<secret-manager>
MAILSENDER_ADMIN_USERNAME=<secret-manager>
MAILSENDER_ADMIN_PASSWORD=<secret-manager>

NOTIFICATION_DEFAULT_LOCALE=es-BO
NOTIFICATION_EMAIL_PROVIDER=disabled
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_SMS_PROVIDER=disabled
NOTIFICATION_WHATSAPP_PROVIDER=disabled
NOTIFICATION_PHONE_PROVIDER=disabled

NOTIFICATION_PROVIDER_HTTP_TIMEOUT_MS=15000
NOTIFICATION_PROVIDER_HTTP_RETRIES=1
NOTIFICATION_PROVIDER_HTTP_RETRY_BASE_DELAY_MS=250
NOTIFICATION_PUSH_INCLUDE_VISIBLE_NOTIFICATION=false

NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=
NOTIFICATION_PHONE_WEBHOOK_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_DEFAULT_TEMPLATE_NAME=
META_WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=es

# PII con envelope encryption. Credenciales AWS por IAM role/workload identity.
KMS_KEY_ID=<arn-o-alias-kms>
AWS_REGION=us-east-1

# Evidencia documental S3/compatible.
STORAGE_S3_ENDPOINT=https://s3.amazonaws.com
STORAGE_S3_BUCKET=<bucket-privado>
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_TTL_SECONDS=300

# External Data Providers — producción debe usar sandbox/production con credenciales reales.
# Dejar en false: con true, la API sirve evidencia KYC/buró INVENTADA y la persiste como features
# del cliente. Si se activa (solo para una demo), EXTERNAL_PROVIDERS_MOCK_BASE_URL pasa a ser
# obligatorio y el arranque falla sin ella.
EXTERNAL_PROVIDERS_ALLOW_MOCK_IN_PRODUCTION=false
EXTERNAL_PROVIDERS_MOCK_BASE_URL=

# Escaneo antimalware de la evidencia subida (clamd por TCP). En producción es obligatorio:
# sin host configurado no hay escaneo y el documento infectado se persiste igual.
MALWARE_SCAN_HOST=<clamd-host>
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=20000
# No bajar a false: dejaría pasar subidas sin revisar cuando el escáner esté caído.
MALWARE_SCAN_FAIL_CLOSED=true
SEGIP_MODE=disabled
SEGIP_BASE_URL=
SEGIP_CLIENT_ID=
SEGIP_CLIENT_SECRET=
INFOCENTER_MODE=disabled
INFOCENTER_BASE_URL=
INFOCENTER_CLIENT_ID=
INFOCENTER_CLIENT_SECRET=
INFOCENTER_ALLOW_AUTOMATIC_QUERIES=false
INFOCENTER_DEFAULT_BLOCK_BY_COST=true
QR_GENERIC_MODE=disabled
BANKING_GENERIC_MODE=disabled
TELCO_GENERIC_MODE=disabled
FACEBOOK_META_MODE=disabled
WHATSAPP_GENERIC_MODE=disabled
DIGITAL_TRUST_GENERIC_MODE=disabled

# --- Credenciales de proveedor externo exigidas por PRODUCTION_CREDENTIAL_REQUIREMENTS ----------
# Requeridas SOLO si se pone el proveedor correspondiente en ${CODE}_MODE=production: sin ellas el
# proceso no arranca. Hoy ninguna tiene consumidor real (ningun adaptador tiene integracion), asi que
# rellenarlas NO habilita el proveedor por si solo. Ver docs/config/credenciales-requeridas.md.
QR_GENERIC_BASE_URL=
BANKING_GENERIC_BASE_URL=
TELCO_GENERIC_BASE_URL=
DIGITAL_TRUST_GENERIC_BASE_URL=
META_FACEBOOK_APP_ID=<secret-manager>
META_FACEBOOK_APP_SECRET=<secret-manager>
META_FACEBOOK_REDIRECT_URI=
# OJO: distinta de NOTIFICATION_WHATSAPP_PROVIDER (que gobierna el ENVIO de notificaciones).
WHATSAPP_PROVIDER=

# External providers v4 resilience / long-term controls
EXTERNAL_PROVIDER_CACHE_TTL_SECONDS=0
EXTERNAL_FEATURE_MAX_AGE_HOURS=168
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
EXTERNAL_PROVIDER_CIRCUIT_BREAKER_WINDOW_MS=600000

# External providers v5 governance
EXTERNAL_PROVIDER_PROD_GATE_SANITIZATION_SAMPLE=200
EXTERNAL_PROVIDER_SLA_FAILURE_WARN_PERCENT=5
EXTERNAL_PROVIDER_SLA_P95_LATENCY_WARN_MS=3000

# Remote append-only sync de Archivo.log hacia MongoDB.
# Guardar la URL real en secret manager, no en archivos versionados.
MONGO_DB_URL_CONNECTION=mongodb+srv://<usuario>:<password>@<cluster-host>/?appName=AtlasBackend
MONGO_LOGS_DB_NAME=atlas_logs
MONGO_LOGS_COLLECTION=archivo_log_updates
LOG_SYNC_FILE_PATH=Archivo.log
LOG_SYNC_INTERVAL_MS=5000
LOG_SYNC_MAX_CHUNK_BYTES=1000000
LOG_SYNC_IMPORT_EXISTING_ON_FIRST_BOOT=false
LOG_SYNC_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
LOG_SYNC_FAILURES_BEFORE_PAUSE=3
LOG_SYNC_FAILURE_PAUSE_MS=60000

SYSTEM_HEALTH_MONITOR_ENABLED=true
SYSTEM_HEALTH_MONITOR_INTERVAL_MS=60000

# Trazas opt-in con muestreo acotado.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# -----------------------------------------------------------------------------
# Trabajos de fondo programados (RuntimeJobsSchedulerService)
# -----------------------------------------------------------------------------
# En produccion esto DEBE estar en true: sin el, el outbox no se despacha, las sesiones
# caducadas no expiran y las politicas de RETENCION de datos personales no se aplican nunca.
# La eleccion de lider usa REDIS_URL; con varias instancias, solo una ejecuta cada tanda.
RUNTIME_JOBS_SCHEDULER_ENABLED=true
RUNTIME_JOBS_ALLOW_WITHOUT_LOCK=false
RUNTIME_JOBS_BATCH_LIMIT=100
RUNTIME_JOBS_LEADER_LOCK_TTL_MS=900000
RUNTIME_JOBS_OUTBOX_INTERVAL_MS=30000
RUNTIME_JOBS_EVENTS_INTERVAL_MS=30000
RUNTIME_JOBS_SESSIONS_INTERVAL_MS=300000
RUNTIME_JOBS_SESSION_MAX_IDLE_MINUTES=120
RUNTIME_JOBS_RETENTION_INTERVAL_MS=86400000
RUNTIME_JOBS_DATA_QUALITY_INTERVAL_MS=3600000
# Rescate de eventos VARADOS en `processing`: los que un proceso reclamo y no llego a resolver
# porque murio a mitad de la tanda. Sin este barrido quedan bloqueados para siempre (toda consulta
# de reclamo filtra por status='pending'). El corte debe superar la duracion normal de una entrega.
RUNTIME_JOBS_STUCK_EVENTS_INTERVAL_MS=300000
RUNTIME_JOBS_STUCK_EVENT_MINUTES=15
# Techo de duracion de UNA tanda. Al vencer se reporta `outcome="stalled"` (metrica + log): el job
# no vuelve a correr hasta que termine, y esa es la senal que convierte un job muerto en algo
# alertable en vez de silencio. 0 lo desactiva.
RUNTIME_JOBS_TICK_TIMEOUT_MS=300000
# Desfase aleatorio del PRIMER disparo de cada job. Evita que N replicas que arrancan juntas pidan
# el mismo lock y consulten la lista de tenants en el mismo milisegundo. 0 lo desactiva.
RUNTIME_JOBS_START_JITTER_MS=15000
RUNTIME_JOBS_NOTIFICATION_RETRY_INTERVAL_MS=300000
RUNTIME_JOBS_NOTIFICATION_STUCK_MINUTES=15
RUNTIME_JOBS_IDEMPOTENCY_PURGE_INTERVAL_MS=86400000
RUNTIME_JOBS_IDEMPOTENCY_RETENTION_DAYS=30
RUNTIME_JOBS_NOTIFICATION_DELIVERY_INTERVAL_MS=10000
# Con APP_ROLE separado, `deferred` saca la entrega del proceso que atiende clientes. Con `all`
# dejalo en `inline`: sin worker no habria quien entregara los mensajes diferidos.
NOTIFICATIONS_DELIVERY_MODE=inline

# -----------------------------------------------------------------------------
# Identidad del build y ciclo de vida del proceso
# -----------------------------------------------------------------------------
# Inyectadas por el pipeline (docker build --build-arg). Sin ellas, /health no puede decir
# que build esta corriendo.
APP_VERSION=<version-del-release>
APP_COMMIT_SHA=<git-sha>
APP_BUILT_AT=<iso-8601>
# stdout es el pipeline de logs real en contenedores: JSON estructurado y con PII redactada.
LOG_FORMAT=json
# Debe ser MAYOR que el intervalo del readiness probe del orquestador (tipicamente 5-10 s),
# o el balanceador seguira enviando trafico a una instancia que ya se esta apagando.
SHUTDOWN_DRAIN_MS=15000
REQUEST_TIMEOUT_MS=30000
# Techo del ping de Postgres del readiness probe. Con el pool agotado, `authenticate()` espera hasta
# DB_POOL_ACQUIRE_MS por una conexion y el probe deja de responder justo cuando su respuesta es la
# informacion mas valiosa: pasa de detectar la saturacion a alimentarla.
HEALTH_DB_PING_TIMEOUT_MS=2000
